# Copy to /opt/law-monitor/.env on the VM (chmod 600). Never commit the real file.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ingest-documents authenticates its caller with auth.getUser(), which the
# service-role key fails — so refreshing a statute needs a real signed-in
# session. Use a dedicated bot account, never a lawyer's own login.
SUPABASE_SESSION_EMAIL=law-monitor-bot@akla.internal
SUPABASE_SESSION_PASSWORD=<password>

ANTHROPIC_API_KEY=<anthropic-key>
