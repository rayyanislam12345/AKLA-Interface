# Copy to /opt/law-monitor/.env on the VM (chmod 600). Never commit the real file.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ingest-documents authenticates its caller with auth.getUser(), which the
# service-role key fails — so refreshing a statute needs a real signed-in
# session. Use a dedicated bot account, never a lawyer's own login.
SUPABASE_SESSION_EMAIL=law-monitor-bot@akla.internal
SUPABASE_SESSION_PASSWORD=<password>

ANTHROPIC_API_KEY=<anthropic-key>

# Morning email (phase 3). Leave unset for in-app notifications only.
# The sending domain must be verified at resend.com first.
RESEND_API_KEY=
LAW_MONITOR_EMAIL_FROM=AKLA Project Hub <updates@example.com>
HUB_URL=https://factoriq.app

# Download relay for sites that do not answer this VM (na.gov.pk,
# pakistancode.gov.pk, the assemblies). Defaults to the chat service's key.
# OFFICIAL_FETCH_RELAY_DIR=/opt/chat-service/.relay
# OFFICIAL_FETCH_RELAY_HOST=aklarelay@157.245.240.172
