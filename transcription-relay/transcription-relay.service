[Unit]
Description=transcription-relay WebSocket relay
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/transcription-relay
EnvironmentFile=/opt/transcription-relay/.env
ExecStart=/usr/bin/node /opt/transcription-relay/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
