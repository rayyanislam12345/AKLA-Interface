[Unit]
Description=AKLA Matter Hub OCR fallback service
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/ocr-service
EnvironmentFile=/opt/ocr-service/.env
ExecStart=/opt/ocr-service/.venv/bin/gunicorn --bind 127.0.0.1:8090 --workers 2 --timeout 1800 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
