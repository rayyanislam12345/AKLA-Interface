SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# A dedicated service-account login (not a real lawyer's credentials) —
# needed only for --confirm, since process-document's internal call to
# ingest-documents requires a genuine signed-in session.
SUPABASE_SESSION_EMAIL=precedent-backlog-bot@yourfirm.internal
SUPABASE_SESSION_PASSWORD=set-a-real-password-here
# Optional — enables tier-2 (LLM-assisted) type classification for files a
# filename match alone can't resolve. Leave unset to run filename-only;
# unresolved files just fall through to "unclear" for manual review.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Optional — dedicated OCR service (see ocr-service/) for scanned PDFs with
# no real text layer. Leave unset to just mark those files failed instead
# of falling back to OCR.
OCR_SERVICE_URL=https://your-ocr-service-domain
OCR_SERVICE_SECRET=match-the-OCR_SHARED_SECRET-set-in-ocr-service/.env
