# caselaw-service environment. Copy to .env on the VM at /opt/caselaw-service.
# The Supabase and Anthropic values are the same the other services use.

# Supabase — auth (JWT + is_firm_member) and persistence (threads, runs, cache)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — planner (Sonnet), grader (Haiku), answer (Sonnet)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# PORT=8094
# CASELAW_MCP_URL=https://pakistancaselaw.com/mcp
# CASELAW_PLANNER_MODEL=claude-sonnet-5
# CASELAW_GRADER_MODEL=claude-haiku-4-5-20251001
# CASELAW_ANSWER_MODEL=claude-sonnet-5
# CASELAW_SHORTLIST=45
# CASELAW_CACHE_TTL_DAYS=30

# Pakistan Law Site — for the official-text verification hook (your credentialed
# piece). The service runs fully without these; they enable the PLS lookup only.
# PLS_USERNAME=
# PLS_PASSWORD=
