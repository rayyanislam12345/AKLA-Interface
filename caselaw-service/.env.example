# caselaw-service environment. Copy to .env on the VM at /opt/caselaw-service.
# The Supabase and Anthropic values are the same the other services use.

# Supabase — auth (JWT + is_firm_member) and persistence (threads, runs, cache)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — planner (Sonnet), grader (Haiku), answer (Sonnet)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# PORT=8094
# CASELAW_MCP_URL=https://pakistancaselaw.com/mcp
# CASELAW_PLANNER_MODEL=claude-sonnet-5
# CASELAW_GRADER_MODEL=claude-haiku-4-5-20251001
# CASELAW_ANSWER_MODEL=claude-sonnet-5
# CASELAW_SHORTLIST=45
# CASELAW_CACHE_TTL_DAYS=30

# Pakistan Law Site — the firm's own sign-in, used to read the official reported
# text of the judgments an answer cites. The service runs without these (answers
# then rest on the other source alone). One account allows one session at a
# time, so give the service an account the lawyers do not share if you can.
# PLS_USERNAME=
# PLS_PASSWORD=
# How long the service stays signed in after its last lookup (ms, default 15000)
# PLS_IDLE_MS=15000
