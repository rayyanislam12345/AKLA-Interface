[Unit]
Description=AKLA Hub connector for claude.ai (read-only MCP server with its own OAuth)
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/chat-service
# Same secrets as chat-service: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_PUBLISHABLE_KEY, ANTHROPIC_API_KEY, VOYAGE_API_KEY. PORT in that
# file is chat-service's; the connector listens on CONNECTOR_PORT.
EnvironmentFile=/opt/chat-service/.env
Environment=CONNECTOR_PORT=8095
Environment=CONNECTOR_ISSUER=https://aklachat.duckdns.org
# The Hub site's address, for the "Open in Hub" lines on every result
# (connector/hubLinks.js). Change it here if the site moves off Vercel.
Environment=CONNECTOR_HUB_URL=https://akla-interface.vercel.app
# Where a registered client may send the lawyer back to after sign-in
# (default claude.ai,claude.com and their subdomains). Never set
# CONNECTOR_ALLOW_LOOPBACK here: it is for a dev box only.
#Environment=CONNECTOR_REDIRECT_HOSTS=claude.ai,claude.com
ExecStart=/usr/bin/node /opt/chat-service/connector/connector.js
# One vCPU shared with chat-service and the index worker: a lawyer's claude.ai
# waits a moment rather than a Hub chat reply being starved.
Nice=5
MemoryMax=600M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
