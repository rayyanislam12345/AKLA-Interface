[Unit]
Description=AKLA Hub connector for claude.ai (MCP server with its own OAuth: reads the Hub; saves new versions into projects after asking, recorded, never deletes)
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/chat-service
# Same secrets as chat-service: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_PUBLISHABLE_KEY, ANTHROPIC_API_KEY, VOYAGE_API_KEY. PORT in that
# file is chat-service's; the connector listens on CONNECTOR_PORT.
EnvironmentFile=/opt/chat-service/.env
Environment=CONNECTOR_PORT=8095
Environment=CONNECTOR_ISSUER=https://aklachat.duckdns.org
# The Hub site's address, for the "Open in Hub" lines on every result
# (connector/hubLinks.js). Change it here if the site moves off Vercel.
Environment=CONNECTOR_HUB_URL=https://akla-interface.vercel.app
# Where a registered client may send the lawyer back to after sign-in
# (default claude.ai,claude.com and their subdomains). Never set
# CONNECTOR_ALLOW_LOOPBACK here: it is for a dev box only.
#Environment=CONNECTOR_REDIRECT_HOSTS=claude.ai,claude.com
# The MCP Apps trial (connector/apps.js): panels inside Claude's replies
# (list_changes, decide_changes, open_document_panel). Off unless set; after
# switching it either way, restart and remove and re-add the connector in
# claude.ai (docs/claude-ai-connector.md, "Trial: changes panel").
Environment=CONNECTOR_APPS=on
# Saving into projects (scope hub:write, granted at sign-in alongside
# hub:read) needs migration 20261020120000_connector_writes.sql applied:
# save_document_version_as and the connector_actions record, both service
# role only. The write caps (30 an hour, 200 a day per person) are fixed in
# connector/projectWrites.js and counted from that table, so a restart of
# this unit does not reset them. There is no setting to switch saving off
# for one person: block the saving tools under Tool permissions in claude.ai
# or withdraw the person's tokens (docs/claude-ai-connector.md).
ExecStart=/usr/bin/node /opt/chat-service/connector/connector.js
# One vCPU shared with chat-service and the index worker: a lawyer's claude.ai
# waits a moment rather than a Hub chat reply being starved.
Nice=5
# A fill of a long Word standard (fill_standard_to_project: the whole file
# read, the changes applied, the fills accepted) takes the process to about
# 500 MB resident while it runs; the tool runs one fill at a time for that
# reason. 1G leaves room for that beside the standards open_standard_for_filling
# keeps in memory; the VM has 5.5 GB.
MemoryMax=1G
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
