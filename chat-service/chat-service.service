[Unit]
Description=AKLA Project Hub AI chat endpoint
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/chat-service
EnvironmentFile=/opt/chat-service/.env
ExecStart=/usr/bin/node /opt/chat-service/server.js
# This is the first user-facing thing on this box: if it dies the AI
# Workspace is simply down, where an ocr-service failure only degrades
# ingestion. Restart aggressively and keep the journal.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
