{
  "key": "escrow",
  "typeName": "Escrow Agreement",
  "source": "Derived 20 October 2026 from the approved escrow pack (5 Packs to check/08 escrow agreement, cut from the owner's chosen base, the firm's 2021 escrow execution draft) by reading its headings with skeletonCheck.js, and compared with the firm's two other escrow precedents: the 2026 escrow agreement (it replaces Article 7 \"Not Used\" with Step-In, Substitution & Concession Direct Agreement Coordination, whose five sections are listed here, and funds the Government's accounts differently) and the 2025 escrow agreement for a project company and advisor (a different, shorter form). Presence: an article (level 1) is \"always\" when every firm precedent of the family read for the study has it, \"optional\" when it belongs to one deal or one form, and \"decision\" when a drafting decision (decisions/escrow.json) turns it on or off. Sections (level 2) are the pack's own, all optional except the ones every precedent has; they are listed so that a section the firm already uses is never reported as a new clause.",
  "completeLevels": [
    1,
    2
  ],
  "headingKinds": {
    "h1": 1,
    "h2": 2,
    "schedule_heading": 1,
    "signature_pages_heading": 1
  },
