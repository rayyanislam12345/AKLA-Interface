{
  "key": "ie-agreement",
  "typeName": "Independent Engineer's Agreement",
  "source": "Derived 20 October 2026 from the approved IE agreement pack (5 Packs to check/04 IE agreement, cut from the firm's June 2026 IE agreement, the owner's chosen base) by reading its headings with skeletonCheck.js, and compared with the firm's 2026 independent expert agreement (the same articles and schedules) and the IA agreement. Presence: an article (level 1) is \"always\" when every firm precedent of the family read for the study has it, \"optional\" when it belongs to one deal or one form, and \"decision\" when a drafting decision (decisions/ie-agreement.json) turns it on or off. Sections (level 2) are the pack's own, all optional except the ones every precedent has; they are listed so that a section the firm already uses is never reported as a new clause.",
  "completeLevels": [
    1,
    2
  ],
  "headingKinds": {
    "h1": 1,
    "h2": 2,
    "schedule_heading": 1,
    "signature_pages_heading": 1
  },
